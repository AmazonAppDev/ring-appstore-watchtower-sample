# ─── Ring Developer Portal credentials (required) ──────────────────────────
# Get these from the Ring Developer Portal when you register your app.
# Required for both local dev and `npm run deploy`.
RING_CLIENT_ID=your_client_id
RING_CLIENT_SECRET=your_client_secret
RING_HMAC_SIGNING_KEY=your_hmac_signing_key

# ─── AWS deployment (required for `npm run deploy`) ────────────────────────
# The region to deploy the stack into. CDK also honors your usual AWS
# credentials (AWS_PROFILE / aws configure) and CDK_DEFAULT_* variables.
AWS_REGION=us-east-1

# The "From" address for passwordless sign-in code emails. It MUST be a
# verified identity in Amazon SES in the region above. While your SES account
# is in the sandbox, the recipient addresses must be verified too.
SES_FROM_EMAIL=noreply@your-verified-domain.com

# After deploy, CDK prints the four URLs to paste into the Ring Developer Portal
# (README steps 5 and 6) and sets DYNAMODB_TABLE and the frontend origin on the
# Lambda automatically — you do NOT set those here.

# ─── Local dev only (optional) ─────────────────────────────────────────────
# These are used ONLY by `npm run dev`. They are ignored on AWS — the deployed
# Lambda serves the SPA from its own origin. Leave them commented unless you
# are running the app locally and need to override the defaults.
#   PORT          backend port (default 3000)
#   FRONTEND_URL  where the account-link flow redirects the user; in local dev
#                 this is the Vite dev server (default http://localhost:5173)
# PORT=3000
# FRONTEND_URL=http://localhost:5173
